{
  "name": "capri",
  "version": "1.0.1",
  "private": true,
  "description": "Local Windows backend for Capri, powered by OpenClaw and Ollama",
  "type": "module",
  "allowScripts": {
    "openclaw": true,
    "electron": true,
    "esbuild": true,
    "koffi": false,
    "@google/genai": false,
    "protobufjs": false
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "mathjs": "15.2.0",
    "openclaw": "2026.10.6",
    "pdfjs-dist": "6.5.438"
  },
  "overrides": {
    "npm": "12.2.2",
    "undici@8": "8.12.2",
    "zod@4": "4.6.6"
  },
  "scripts": {
    "postinstall": "node packages/runtime/bin/patch-openclaw.mjs",
    "start": "node packages/runtime/bin/core.mjs start",
    "stop": "node packages/runtime/bin/core.mjs stop",
    "status": "node packages/runtime/bin/core.mjs status",
    "chat": "node packages/runtime/bin/core.mjs chat",
    "test": "node tools/checks/test.mjs",
    "verify": "node tools/verify/verify.mjs",
    "desktop": "node packages/runtime/bin/capri.mjs desktop",
    "verify:desktop": "node tools/verify/verify-desktop.mjs",
    "verify:settings": "node tools/verify/verify-settings.mjs",
    "verify:desktop:real": "node tools/verify/verify-desktop.mjs --real",
    "benchmark:latency": "node tools/benchmarks/benchmark-latency.mjs",
    "verify:routing": "node tools/verify/verify-request-routing.mjs",
    "setup:routing": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/setup-request-router.ps1",
    "verify:voice": "node tools/verify/verify-companion-voice.mjs",
    "verify:subtitles": "node tools/verify/verify-speech-subtitles.mjs",
    "verify:sleep": "node tools/verify/verify-sleep.mjs",
    "verify:voice-effects": "node tools/verify/verify-voice-effects.mjs",
    "verify:languages": "node tools/verify/verify-languages.mjs",
    "verify:files": "node tools/verify/verify-file-access.mjs",
    "verify:applications": "node tools/verify/verify-application-actions.mjs",
    "verify:awareness": "node tools/verify/verify-awareness.mjs",
    "verify:initiative": "node tools/verify/verify-initiative-model.mjs",
    "verify:screen": "node tools/verify/verify-screen-capture.mjs",
    "verify:screen:real": "node tools/verify/verify-screen-capture.mjs --real",
    "verify:visual-context": "node tools/verify/verify-visual-context.mjs",
    "verify:context": "node tools/verify/verify-context-pressure.mjs",
    "configure:perception": "node tools/configuration/configure-perception.mjs",
    "configure:files": "node tools/configuration/configure-filesystem.mjs",
    "configure:applications": "node tools/configuration/configure-applications.mjs",
    "verify:microphone": "node tools/verify/verify-desktop-microphone.mjs",
    "verify:wake": "node tools/verify/verify-wake-phrase.mjs",
    "verify:audio-inputs": "node tools/verify/verify-audio-inputs.mjs",
    "verify:dialogue": "node tools/verify/verify-dialogue-style.mjs",
    "configure:dialogue": "node tools/configuration/configure-dialogue.mjs",
    "configure:performance": "node tools/configuration/configure-performance.mjs",
    "configure:context": "node tools/configuration/configure-context.mjs",
    "setup:spotify": "node integrations/spotify/provision.mjs && node tools/configuration/configure-spotify.mjs",
    "verify:spotify": "node tools/verify/verify-spotify.mjs",
    "verify:spotify:dialogue": "node tools/verify/verify-spotify-dialogue.mjs",
    "verify:visuals": "node tools/verify/verify-visuals.mjs",
    "build:sprites": "node tools/assets/build-sprite-catalog.mjs",
    "clean:cache": "node tools/maintenance/clean-cache.mjs",
    "verify:observation": "node tools/verify/verify-screen-observation.mjs",
    "verify:observation:real": "node tools/verify/verify-screen-observation.mjs --real",
    "verify:clips": "node tools/verify/verify-screen-clips.mjs",
    "build:locales": "node tools/localization/apply-interface-glossary.mjs && node tools/localization/build-interface-locales.mjs",
    "verify:locales": "node tools/verify/verify-interface-locales.mjs",
    "verify:dimming": "node tools/verify/verify-window-dimming.mjs",
    "doctor": "node packages/runtime/bin/capri.mjs doctor",
    "setup": "node packages/runtime/bin/capri.mjs setup",
    "models:pull": "node packages/runtime/bin/capri.mjs models",
    "check": "node tools/checks/source.mjs",
    "test:assets": "node --test tests/desktop-avatar.test.mjs tests/desktop-animation.test.mjs",
    "release:source": "node tools/release/source-export.mjs",
    "release:check": "node tools/release/source-export.mjs --check",
    "format": "prettier --write --log-level warn .",
    "format:check": "prettier --check .",
    "test:runtime": "node --test tests/runtime-foundation.test.mjs tests/desktop-boundaries.test.mjs",
    "release:installer": "node tools/release/build-installer.mjs",
    "verify:installer": "node tools/verify/verify-installer.mjs"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "playwright-core": "1.63.0",
    "prettier": "3.6.2"
  },
  "license": "GPL-3.0-only",
  "workspaces": [
    "packages/runtime",
    "apps/desktop"
  ]
}
